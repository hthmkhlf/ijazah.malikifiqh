---
const year = new Date().getFullYear();
---

<footer class="px-6 py-16 text-center sm:px-8">
	<div class="mx-auto flex max-w-2xl flex-col items-center gap-4">
		<div class="flex items-center gap-3" aria-hidden="true">
			<span class="h-px w-10 bg-[var(--color-border)] sm:w-16"></span>
			<span class="h-2 w-2 rotate-45 bg-[var(--color-accent)]"></span>
			<span class="h-px w-10 bg-[var(--color-border)] sm:w-16"></span>
		</div>

		<p class="text-sm text-[var(--color-text-secondary)]">
			A collaborative effort to preserve and transmit traditional Islamic scholarship.
		</p>
		<p class="text-xs text-[var(--color-text-secondary)]">
			&copy; {year} Ijazah in Maliki Fiqh. All rights reserved.
		</p>
	</div>
</footer>
